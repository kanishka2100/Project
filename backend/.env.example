# FlavorShift AI — Environment Variables
# Copy to .env and configure for local deployment

# Debug mode (true enables verbose SQL and docs)
FLAVORSHIFT_DEBUG=true

# Database URL (SQLite async for local dev; PostgreSQL for production)
FLAVORSHIFT_DATABASE_URL=sqlite+aiosqlite:///./flavorshift.db

# Groq Cloud API Key (free tier at https://console.groq.com)
# Required for Llama 3.1-8B SOP rewriting
FLAVORSHIFT_GROQ_API_KEY=

# Groq Model Name
FLAVORSHIFT_GROQ_MODEL_NAME=llama-3.1-8b-instant

# Allowed CORS Origins
FLAVORSHIFT_CORS_ORIGINS=["http://localhost:8080","http://localhost:3000","https://kanishka2100.github.io"]

# Redis URL (optional, for caching)
FLAVORSHIFT_REDIS_URL=redis://localhost:6379/0

# Model Paths
FLAVORSHIFT_FLAVORGRAPH_VECTORS_PATH=data/flavorgraph_vectors/embeddings.npy
FLAVORSHIFT_SENSORY_ONNX_MODEL_PATH=data/sensory_model/sensory_model.onnx
